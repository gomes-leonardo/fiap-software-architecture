# Template de variaveis de ambiente.
# Copie para .env antes de rodar a aplicacao ou o docker-compose:
#
#   cp .env.example .env
#
# O .env esta no .gitignore e nunca deve ser commitado.

# Database
# DB_HOST/DB_PORT valem para o fluxo local (`npm run start:dev` com o banco em
# container). No docker-compose o app usa o servico `db` na soat-network.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=soat_repair_shop
DB_USER=postgres
# Obrigatoria: o docker-compose falha se DB_PASS nao estiver definida.
# Troque por um valor forte fora de dev.
DB_PASS=postgres

# Endereco de bind do Postgres publicado pelo docker-compose.
# Default 127.0.0.1 = acessivel so pela maquina local (o banco continua
# alcancavel pelo app via soat-network). Use 0.0.0.0 apenas se precisar
# acessar o banco de outra maquina da rede.
DB_BIND_ADDRESS=127.0.0.1

# JWT
# Obrigatoria: o docker-compose falha se JWT_SECRET nao estiver definida.
# Em producao, gere um segredo aleatorio (ex.: openssl rand -base64 48).
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=1h

# App
PORT=3000
NODE_ENV=development
