# Template de variaveis de ambiente.
# Copie para .env antes de rodar a aplicacao ou o docker-compose:
#
#   cp .env.example .env
#
# O .env esta no .gitignore e nunca deve ser commitado.

# Database
# DB_HOST/DB_PORT valem para o fluxo local (`npm run start:dev` com o banco em
# container). No docker-compose o app usa o servico `db` na soat-network.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=soat_repair_shop
DB_USER=postgres
# Obrigatoria: o docker-compose falha se DB_PASS nao estiver definida.
# Troque por um valor forte fora de dev.
DB_PASS=postgres

# Endereco de bind do Postgres publicado pelo docker-compose.
# Default 127.0.0.1 = acessivel so pela maquina local (o banco continua
# alcancavel pelo app via soat-network). Use 0.0.0.0 apenas se precisar
# acessar o banco de outra maquina da rede.
DB_BIND_ADDRESS=127.0.0.1

# JWT
# Obrigatoria: sem ela a aplicacao nao sobe (e o docker-compose falha antes).
# Nao existe default no codigo de proposito — um fallback deixaria a app
# assinando token com um segredo publicado no repositorio, sem nenhum sintoma.
# Em producao, gere um segredo aleatorio (ex.: openssl rand -base64 48).
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=1h

# Primeiro administrador
# Fora de desenvolvimento nenhum admin e criado automaticamente: o
# admin@oficina.com / admin123 do README so nasce quando NODE_ENV != production.
# Como `POST /auth/register` exige um admin autenticado, defina estas duas
# variaveis para criar o administrador inicial no boot (em qualquer ambiente).
# Elas so tem efeito enquanto esse email ainda nao existir no banco.
# Obrigatorias sempre que NODE_ENV=production — e o docker-compose e os
# manifestos K8s usam production. Sem elas nenhum administrador e criado no
# boot, e como POST /auth/register exige token, nao ha como criar o primeiro
# pela API: todo login responde 401.
ADMIN_BOOTSTRAP_EMAIL=admin@oficina.com
ADMIN_BOOTSTRAP_PASSWORD=troque-por-uma-senha-forte
ADMIN_BOOTSTRAP_NAME=Administrador

# Webhook de integracao externa
# Segredo pre-compartilhado que sistemas externos apresentam em
# `POST /webhooks/service-orders/:id/status`, via
# `Authorization: Bearer <segredo>` (preferido) ou no campo `token` do corpo.
# Sem esta variavel o endpoint recusa TODA chamada — falha fechada de proposito.
# Gere um valor aleatorio: openssl rand -base64 48
WEBHOOK_SECRET=change-me-webhook-secret

# App
PORT=3000
NODE_ENV=development
