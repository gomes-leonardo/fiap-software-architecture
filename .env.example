# Template de variaveis de ambiente.
# Copie para .env antes de rodar a aplicacao ou o docker-compose:
#
#   cp .env.example .env
#
# O .env esta no .gitignore e nunca deve ser commitado.

# Database
# DB_HOST/DB_PORT valem para o fluxo local (`npm run start:dev` com o banco em
# container). No docker-compose o app usa o servico `db` na soat-network.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=soat_repair_shop
DB_USER=postgres
# Obrigatoria: o docker-compose falha se DB_PASS nao estiver definida.
# Troque por um valor forte fora de dev.
DB_PASS=postgres

# Endereco de bind do Postgres publicado pelo docker-compose.
# Default 127.0.0.1 = acessivel so pela maquina local (o banco continua
# alcancavel pelo app via soat-network). Use 0.0.0.0 apenas se precisar
# acessar o banco de outra maquina da rede.
DB_BIND_ADDRESS=127.0.0.1

# JWT
# Obrigatoria: sem ela a aplicacao nao sobe (e o docker-compose falha antes).
# Nao existe default no codigo de proposito — um fallback deixaria a app
# assinando token com um segredo publicado no repositorio, sem nenhum sintoma.
# Em producao, gere um segredo aleatorio (ex.: openssl rand -base64 48).
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=1h

# Primeiro administrador
# Fora de desenvolvimento nenhum admin e criado automaticamente: o
# admin@oficina.com / Admin@Oficina2026 do README so nasce quando NODE_ENV != production.
# Como `POST /auth/register` exige um admin autenticado, defina estas duas
# variaveis para criar o administrador inicial no boot (em qualquer ambiente).
# Elas so tem efeito enquanto esse email ainda nao existir no banco.
# Obrigatorias sempre que NODE_ENV=production — e o docker-compose e os
# manifestos K8s usam production. Sem elas nenhum administrador e criado no
# boot, e como POST /auth/register exige token, nao ha como criar o primeiro
# pela API: todo login responde 401.
ADMIN_BOOTSTRAP_EMAIL=admin@oficina.com
ADMIN_BOOTSTRAP_PASSWORD=troque-por-uma-senha-forte
ADMIN_BOOTSTRAP_NAME=Administrador

# Webhook de integracao externa
# Segredo pre-compartilhado que sistemas externos apresentam em
# `POST /webhooks/service-orders/:id/status`, via
# `Authorization: Bearer <segredo>` (preferido) ou no campo `token` do corpo.
# Sem esta variavel o endpoint recusa TODA chamada — falha fechada de proposito.
# Gere um valor aleatorio: openssl rand -base64 48
WEBHOOK_SECRET=change-me-webhook-secret

# App
PORT=3000
NODE_ENV=development

# CORS: origens que podem chamar a API pelo browser, separadas por virgula.
# Vazio = nenhuma (a API e consumida pelo gateway e servidor a servidor).
CORS_ORIGINS=
# Swagger em /api-docs: ligado por padrao fora de producao. "false" desliga,
# "true" liga mesmo com NODE_ENV=production (homologacao).
SWAGGER_ENABLED=

# Observabilidade
# Endereco de bind das portas que o docker-compose publica para Prometheus
# (9090) e Grafana (3002). Mesma logica do DB_BIND_ADDRESS. O Grafana sobe com
# acesso anonimo no papel Editor e sem tela de login para a demo, entao manter
# em 127.0.0.1 nao e preferencia: e o que impede qualquer um na rede de editar
# os seus dashboards sem autenticar.
OBSERVABILITY_BIND_ADDRESS=127.0.0.1

# Estas duas valem apenas para `npm run start:dev`. O servico `app` do
# docker-compose enumera o proprio environment e nao usa env_file, e o
# mapeamento da porta esta fixo no compose — editar aqui nao tem efeito la.
#
# Onde o app expoe /metrics para o Prometheus raspar. Porta separada da API de
# proposito: nao vai para o Ingress e nao passa pelos middlewares do Nest — por
# isso uma raspagem nao gera linha de log nem aparece no Swagger.
OTEL_METRICS_PORT=9464
# O default do exportador e `localhost`, que resolve para loopback e nao e
# alcancavel de outro container nem de outro pod. Quem garante `0.0.0.0` no
# compose e no Kubernetes e o default do codigo (src/instrumentation.ts), nao
# esta variavel — ela existe para o caso de voce querer restringir o bind.
OTEL_METRICS_HOST=0.0.0.0

# Para onde os traces sao empurrados (OTLP/HTTP). No fluxo local o Jaeger
# publica a 4318 no host; dentro do compose o endereco e http://jaeger:4318.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Imprime cada span no stdout, util para depurar instrumentacao sem abrir o
# Jaeger. Deixe desligado: e uma linha por span.
# OTEL_CONSOLE=1
