            },
            "description": "O CPF é gerado na hora, sempre válido e diferente, para a jornada rodar quantas vezes precisar.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ana Demonstração\",\n  \"cpfCnpj\": \"{{cpf_demo}}\",\n  \"email\": \"ana.demo@email.com\",\n  \"phone\": \"(11) 98888-0001\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const n = Array.from({ length: 9 }, () => Math.floor(Math.random() * 10));",
                  "const dv = (a) => { const s = a.reduce((acc, v, i) => acc + v * (a.length + 1 - i), 0); const r = (s * 10) % 11; return r === 10 ? 0 : r; };",
                  "n.push(dv(n)); n.push(dv(n));",
                  "pm.collectionVariables.set('cpf_demo', n.join(''));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 201', () => pm.response.to.have.status(201));",
                  "const c = pm.response.json();",
                  "pm.collectionVariables.set('client_id', c.id);",
                  "const shown = { id: c.id, nome: c.name, cpf: c.cpfCnpj, status: c.status };",
                  "pm.visualizer.set('<pre style=\"font-size:18px;line-height:1.5\">{{json}}</pre>', { json: JSON.stringify(shown, null, 2) });"
                ]
              }
            }
          ]
