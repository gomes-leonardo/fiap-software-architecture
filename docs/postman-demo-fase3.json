  "item": [
    {
      "name": "Bloco 2 · Login por CPF (Kong → Lambda)",
      "item": [
        {
          "name": "2.1 Login do João por CPF → 200 com JWT",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/cpf",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "cpf"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Kong (18080) → Lambda soat-prd-auth-cpf → Neon. Guarda o token em {{token_cliente}} e mostra o payload em Visualization.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cpf\": \"529.982.247-25\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 200', () => pm.response.to.have.status(200));",
                  "const cryptoJs = require('crypto-js');",
                  "const decode = (t) => { const p = t.split('.')[1].replace(/-/g, '+').replace(/_/g, '/'); return JSON.parse(cryptoJs.enc.Base64.parse(p).toString(cryptoJs.enc.Utf8)); };",
                  "const t = pm.response.json().access_token;",
                  "pm.collectionVariables.set('token_cliente', t);",
                  "const p = decode(t);",
                  "pm.collectionVariables.set('joao_id', p.sub);",
                  "const shown = p;",
                  "pm.visualizer.set('<pre style=\"font-size:18px;line-height:1.5\">{{json}}</pre>', { json: JSON.stringify(shown, null, 2) });"
                ]
              }
            }
          ]
        },
